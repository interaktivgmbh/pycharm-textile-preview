<idea-plugin>
  <id>de.interaktiv.textilepreview</id>
  <name>Textile Preview</name>
  <vendor url="https://www.interaktiv.de">Interaktiv GmbH</vendor>
  <description><![CDATA[
    Renders <code>```textile</code> code fences in the Markdown preview,
    with a few Redmine extras: the <code>{{collapse}}</code> macro and
    images referenced by file name only.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.intellij.plugins.markdown</depends>

  <extensions defaultExtensionNs="org.intellij.markdown">
    <!-- "first": the built-in highlighter accepts every fence language -->
    <fenceGeneratingProvider order="first" implementation="de.interaktiv.textilepreview.TextileFenceProvider"/>
    <browserPreviewExtensionProvider implementation="de.interaktiv.textilepreview.TextileStylesExtension$Provider"/>
  </extensions>
</idea-plugin>
